COMPOSE_PROJECT_NAME=chatflows-local-true

# Host ports (127.0.0.1 only)
LOCAL_CONSOLE_PORT=15174
LOCAL_NEST_BFF_PORT=13101
LOCAL_NEST_MCP_PORT=13110
LOCAL_RUNTIME_PORT=18098
LOCAL_HIGRESS_CONSOLE_PORT=18011
LOCAL_HIGRESS_GATEWAY_PORT=18081
LOCAL_HIGRESS_HTTPS_PORT=18443
LOCAL_MINIO_API_PORT=19010
LOCAL_MINIO_CONSOLE_PORT=19011
LOCAL_POSTGRES_PORT=15432
LOCAL_REDIS_PORT=16379
LOCAL_BUSINESS_MCP_PORT=13200

# PostgreSQL
POSTGRES_DB=chatflows
POSTGRES_ADMIN_PASSWORD=replace-postgres-admin-password
CHATFLOWS_APP_DB_PASSWORD=replace-chatflows-app-db-password
AGENT_RUNTIME_DB_PASSWORD=replace-agent-runtime-db-password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-minio-root-password
MINIO_BUCKET=chatflows-artifacts

# Higress
HIGRESS_IMAGE_TAG=2.1.7
HIGRESS_ADMIN_USER=admin
HIGRESS_ADMIN_PASSWORD=replace-higress-admin-password
HIGRESS_GATEWAY_CONSUMER=chatflows-local
HIGRESS_CONSUMER_TOKEN=replace-higress-consumer-token-at-least-16
HIGRESS_MODEL_PROVIDER=qwen
HIGRESS_DASHSCOPE_API_KEY=
# Optional OpenAI-compatible upstream (Alibaba Cloud MaaS). Empty = native qwen/DashScope.
HIGRESS_OPENAI_API_URL=
HIGRESS_QWEN_MODELS=*

# Shared app tokens
WEB_AUTH_TOKEN=replace-wizard-token-at-least-16
WEB_AUTH_CLIENT_CODE=acme_beauty
PIPELINE_CONTROL_TOKEN=replace-pipeline-token-at-least-16
PIPELINE_APPROVAL_SIGNING_SECRET=replace-approval-signing-secret-at-least-32
RUNTIME_AUTH_TOKEN=replace-runtime-token-at-least-16
RUNTIME_ADMIN_TOKEN=replace-runtime-admin-token-at-least-16
BLUEPRINT_ADMIN_TOKEN=replace-blueprint-admin-token-at-least-16

# Local business MCP
BUSINESS_MCP_BACKEND_TOKEN=${HIGRESS_CONSUMER_TOKEN}

# Console multi-tenant sample credentials
WEB_AUTH_CREDENTIALS=[{"token":"replace-beauty-token-at-least-16","client_code":"acme_beauty","roles":["user","admin"]},{"token":"replace-agri-token-at-least-16","client_code":"acme_agri","roles":["user","admin"]},{"token":"replace-edu-token-at-least-16","client_code":"acme_edu","roles":["user","admin"]}]

# Runtime / Nest model defaults
RUNTIME_MODEL=dashscope:deepseek-v4-flash-0731
QWEN_MODEL=deepseek-v4-flash-0731

# Optional observability, off by default locally
AGENTLOOP_EXPORTER=off
AGENTLOOP_SAMPLE_RATE=1.0
AGENTLOOP_PROTOCOL=otlp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_HEADERS=
ARMS_LICENSE_KEY=
AGENTLOOP_ENDPOINT=
AGENTLOOP_ACCESS_KEY=
AGENTLOOP_ACCESS_SECRET=
