RUNTIME_MODE=production
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8088
RUNTIME_AUTH_TOKEN=replace-with-at-least-16-characters
RUNTIME_ADMIN_TOKEN=replace-with-a-different-admin-token
RUNTIME_MODEL=dashscope:qwen-plus
RUNTIME_LLM_BASE_URL=http://agentteams-higress:8080/v1
RUNTIME_LLM_TOKEN=replace-with-higress-consumer-token
AGENTSCOPE_WORKSPACE=/app/workspace
DATABASE_URL=jdbc:postgresql://postgres:5432/chatflows
DATABASE_USER=agent_runtime_login
DATABASE_PASSWORD=
REDIS_URL=redis://redis:6379/0
RUNTIME_MCP_URL=http://<GATEWAY_HOST>:18080/mcp-servers/business-tools
RUNTIME_MCP_TOKEN=
BLUEPRINT_ADMIN_URL=http://agent-core:3100
BLUEPRINT_ADMIN_TOKEN=
AGENTLOOP_EXPORTER=off
AGENTLOOP_ENDPOINT=
AGENTLOOP_ACCESS_KEY=
AGENTLOOP_ACCESS_SECRET=
AGENTLOOP_SAMPLE_RATE=1.0
