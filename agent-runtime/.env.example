## agent-runtime 兼容启动样例
## 新主体实现来自 sales-customer-agent，但仍兼容旧入口与旧 v1 chat 鉴权变量。

## 旧运行时兼容变量
RUNTIME_PORT=8088
RUNTIME_AUTH_TOKEN=replace-with-runtime-bearer-token
RUNTIME_ADMIN_TOKEN=replace-with-a-different-admin-token

## 新底座 Web 端口；若未配置，会自动复用 RUNTIME_PORT
# AGENT_WEB_PORT=18080

## 旧 /api/v1/chat Bearer 校验开关；默认会在存在 RUNTIME_AUTH_TOKEN 时自动开启
# AGENT_COMPAT_V1_CHAT_AUTH_ENABLED=true
# AGENT_COMPAT_V1_CHAT_AUTH_TOKEN=replace-with-runtime-bearer-token

## 模型配置
AGENT_MODEL_NAME=deepseek-v4-flash
AGENT_MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-model-token
RUNTIME_MODEL=dashscope:deepseek-v4-flash
RUNTIME_LLM_BASE_URL=http://agentteams-higress:8080/v1
RUNTIME_LLM_TOKEN=replace-with-higress-consumer-token

## Blueprint JDBC
AGENT_BLUEPRINT_SOURCE=jdbc
AGENT_BLUEPRINT_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/chatflows
AGENT_BLUEPRINT_JDBC_USERNAME=replace-with-blueprint-user
AGENT_BLUEPRINT_JDBC_PASSWORD=replace-with-blueprint-password
BLUEPRINT_ADMIN_URL=http://agent-core:3100
BLUEPRINT_ADMIN_TOKEN=

## Runtime Tool 后端
AGENT_RUNTIME_API_BASE_URL=http://127.0.0.1:3002
# AGENT_RUNTIME_API_TOKEN=
RUNTIME_MCP_URL=http://<GATEWAY_HOST>:18080/mcp-servers/business-tools
RUNTIME_MCP_TOKEN=

## 会话存储
AGENT_MYSQL_DATABASE=replace-with-mysql-db
AGENT_MYSQL_USERNAME=replace-with-mysql-user
AGENT_MYSQL_PASSWORD=replace-with-mysql-password

## Chat run 日志持久化
AGENT_CHAT_RUN_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/chatflows
AGENT_CHAT_RUN_JDBC_USERNAME=agent_runtime_login
AGENT_CHAT_RUN_JDBC_PASSWORD=
AGENT_CHAT_RUN_TABLE=agent_runtime_chat_runs
AGENT_CHAT_RUN_EVENT_TABLE=agent_runtime_chat_run_events

DATABASE_URL=jdbc:postgresql://postgres:5432/chatflows
DATABASE_USER=agent_runtime_login
DATABASE_PASSWORD=
REDIS_URL=redis://redis:6379/0
AGENTSCOPE_WORKSPACE=/app/workspace

## 默认作用域
AGENT_DEFAULT_CLIENT_CODE=yjiyuncom
AGENT_DEFAULT_CLUSTER=test
AGENT_DEFAULT_SCENE_CODE=BEAUTY_SKINCARE

# ============================================================
# AgentLoop 可观测上报配置
# ------------------------------------------------------------
# LicenseKey 从密钥管理服务注入，切勿把真实值写进受版本控制的文件。
# ============================================================

# ---- AgentLoop 上报开关 ----
# EXPORTER: on=真上报公网 | stderr=只打本地日志(灰度用) | off=完全关闭。
# 生产首次上线可先用 stderr 确认无误，再切 on。
AGENTLOOP_EXPORTER=on
AGENTLOOP_SAMPLE_RATE=1.0
AGENTLOOP_PROTOCOL=otlp

# ---- OTLP 标准直发参数(OTel SDK autoconfigure 直读) ----
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou.cn-guangzhou.log.aliyuncs.com/apm/trace/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.version=v0.1.0,deployment.environment=production,acs.cms.workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5,acs.arms.service.feature=genai_app,gen_ai.instrumentation.sdk.name=loongsuite-genai-utils

# ---- 正文采集开关(控制台 Input/Output 摘要，方案 §5.3) ----
# BlueprintTraceMiddleware 从 Agent 输入/结果取正文写 gen_ai.input.messages / gen_ai.output.messages。
# 蓝图正文含 PII/密钥时设为 false(或 none)整体关闭；关闭后调用链与 token 仍正常。默认采集。
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_and_event

# ---- 鉴权(从 Secret 注入，勿硬编码) ----
# OTEL_EXPORTER_OTLP_HEADERS 里的 ${ARMS_LICENSE_KEY} 需要运行环境做变量插值。
# 若用纯 docker environment: 块(不插值)，需把 key 直接拼进 headers 字符串或用 secret 挂载。
ARMS_LICENSE_KEY=<从密钥管理服务注入>
OTEL_EXPORTER_OTLP_HEADERS=x-arms-license-key=${ARMS_LICENSE_KEY},x-arms-project=proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou,x-cms-workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5

# ---- 旧 ROA 协议参数(默认走 otlp，无需设置) ----
# 仅当 AGENTLOOP_PROTOCOL=roa 回滚时才填以下三项：
# AGENTLOOP_ENDPOINT=
# AGENTLOOP_ACCESS_KEY=
# AGENTLOOP_ACCESS_SECRET=

# ---- 每进程独有身份 ----
# 三个进程各有代码内置默认名(manager→vibe-sales-manager / runtime→vibe-sales-runtime / nest→vibe-sales-nest)。
# 若本文件被【多进程共用】，保持注释掉，否则三进程会同名、控制台归不成一棵树。
# 只有当【某进程单独用一份 env】且想覆盖默认名时，才在那份 env 里显式设置：
# OTEL_SERVICE_NAME=<按进程填写，如 vibe-sales-manager / vibe-sales-runtime / vibe-sales-nest>
