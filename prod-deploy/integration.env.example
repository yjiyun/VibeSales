# ============================================================================
# integration.env.example
# 用途：VibeSales 生产环境统一真源 Env 示例文件
# 说明：
#   1) 本文件基于当前生产使用中的 integration.env 脱敏整理
#   2) 10.1.1.42 统一替换为“内网地址”，端口保持不变
#   3) token / password / 敏感账号统一替换为占位符
#   4) 可被 prod-deploy/split-integration-env.sh 拆分为三个独立 EnvFile
#
# 配置方式标记：
#   [1] 手工按环境设置
#   [2] 自定义设置
#   [3] 执行脚本后手工回填
#   [4] 执行脚本自动写回 deploy/agentteams/integration.env
# ============================================================================

# ============================================================================
# §A 服务自身配置
# ============================================================================

# [1] 手工按环境设置：服务监听地址
WEB_HOST=0.0.0.0
# [1] 手工按环境设置：VibeSales 代码根目录
CHATFLOWS_ROOT=/home/pad/chatflows
# [固定] 产物存储后端
ARTIFACT_STORE=postgres
# [2] 自定义设置：数据库连接池大小
DATABASE_POOL_SIZE=10
# [1] 手工按环境设置：0=关闭数据库 SSL
DATABASE_SSL=0
# [固定] VibeSales Artifact 桶名
MINIO_BUCKET=chatflows-artifacts
# [固定] 生产模式
FLOW_PLATFORM_MODE=production
# [固定] 对接 AgentTeams 平台编排
ORCHESTRATION_MODE=platform
# [固定] YunFlow dry-run 路径模板
YUNFLOW_DRY_RUN_PATH=/api/workflow/{workflow_id}/run
# [固定] 同机原生 agent-runtime 地址
AGENT_RUNTIME_URL=http://127.0.0.1:8088

# [固定] runtime 运行模式
RUNTIME_MODE=production
# [固定] 同机原生监听
RUNTIME_HOST=127.0.0.1
# [1] 手工按环境设置：runtime 端口
RUNTIME_PORT=8088
# [1] 手工按环境设置：runtime 工作目录
AGENTSCOPE_WORKSPACE=/home/pad/chatflows/runtime-workspace
# [固定] runtime PG 登录角色名
DATABASE_USER=agent_runtime_login
# [固定] 同机 agent-core Blueprint 管理面
BLUEPRINT_ADMIN_URL=http://127.0.0.1:3100
# [2] 自定义设置：sales-customer-agent 模型名（仅模型名，不含 provider 前缀
AGENT_MODEL_NAME=qwen-plus

# [固定] manager 同机原生监听
MANAGER_HOST=127.0.0.1
# [1] 手工按环境设置：manager 端口
MANAGER_PORT=8090
# [2] 自定义设置：单次编排超时秒数
AGENTTEAMS_RUN_TIMEOUT_SECONDS=3600
# [2] 自定义设置：AgentTeams Team 名
AGENTTEAMS_TEAM_NAME=chatflows-build-team
# [2] 自定义设置：AgentTeams Leader 名
AGENTTEAMS_LEADER_NAME=chatflows-leader
# [1] 手工按环境设置：team.yaml 路径
AGENTTEAMS_TEAM_FILE=/home/pad/chatflows/agentteams-resources/team.yaml
# [固定] 同机 agent-core 控制面地址
CHATFLOWS_NEST_URL=http://127.0.0.1:3100
# [2] 自定义设置：当前关闭编排层直连 LLM
ORCHESTRATOR_LLM=off
# [2] 自定义设置：编排层模型档位
ORCHESTRATOR_MODEL=dashscope:qwen-plus
# [1] 手工按环境设置：编排状态目录
ORCHESTRATOR_STATE_HOME=/home/pad/chatflows/orchestrator-state
# [固定] Task FS 桶名
CHATFLOWS_TASK_FS_BUCKET=agentteams-storage
# [固定] Task FS 前缀
CHATFLOWS_TASK_FS_PREFIX=teams/chatflows-build-team/shared/tasks
# [1] 手工按环境设置：phase1 文件路径
AGENTTEAMS_PHASE1_RESULT_FILE=/home/pad/chatflows/agent-console-phase1-result.json

# [2] 自定义设置：可观测开关
AGENTLOOP_EXPORTER=off
# [2] 自定义设置：采样率
AGENTLOOP_SAMPLE_RATE=1.0
# [固定] OTLP 协议族
AGENTLOOP_PROTOCOL=otlp
# [固定] OTLP 导出协议
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ============================================================================
# §B 内部鉴权与业务令牌
# ============================================================================

# [2] 自定义设置：MCP 面令牌；必须与 HIGRESS_CONSUMER_TOKEN 同值
MCP_SERVER_TOKEN=__CUSTOM_MCP_SERVER_TOKEN__
# [2] 自定义设置：Higress Consumer 令牌；必须与 MCP_SERVER_TOKEN 同值
HIGRESS_CONSUMER_TOKEN=__CUSTOM_MCP_SERVER_TOKEN__

# [2] 自定义设置：Pipeline 控制面令牌
PIPELINE_CONTROL_TOKEN=__CUSTOM_PIPELINE_CONTROL_TOKEN__
# [2] 自定义设置：Blueprint 管理令牌
BLUEPRINT_ADMIN_TOKEN=__CUSTOM_BLUEPRINT_ADMIN_TOKEN__
# [2] 自定义设置：Runtime 调 agent-core 私有通道令牌
RUNTIME_AUTH_TOKEN=__CUSTOM_RUNTIME_AUTH_TOKEN__
# [2] 自定义设置：agent-core 对 runtime 私有通道令牌；必须与 RUNTIME_AUTH_TOKEN 同值
AGENT_RUNTIME_TOKEN=__CUSTOM_RUNTIME_AUTH_TOKEN__
# [2] 自定义设置：Runtime 管理令牌
RUNTIME_ADMIN_TOKEN=__CUSTOM_RUNTIME_ADMIN_TOKEN__

# [2] 自定义设置：审批签名密钥；必须与 CHATFLOWS_APPROVAL_SIGNING_SECRET 同值
PIPELINE_APPROVAL_SIGNING_SECRET=__CUSTOM_APPROVAL_SIGNING_SECRET__
# [2] 自定义设置：审批签名密钥；必须与 PIPELINE_APPROVAL_SIGNING_SECRET 同值
CHATFLOWS_APPROVAL_SIGNING_SECRET=__CUSTOM_APPROVAL_SIGNING_SECRET__

# [2] 自定义设置：Manager 对外读写令牌
MANAGER_AUTH_TOKEN=__CUSTOM_MANAGER_AUTH_TOKEN__
# [2] 自定义设置：Manager 管理令牌
MANAGER_ADMIN_TOKEN=__CUSTOM_MANAGER_ADMIN_TOKEN__

# ============================================================================
# §C 业务默认值与 Matrix 身份白名单
# ============================================================================

# [2] 自定义设置：Human 白名单；完整 Matrix User ID，逗号分隔可扩展
AGENTTEAMS_HUMAN_IDS=@__SET_HUMAN_MATRIX_USER_ID__
# [2] 自定义设置：Leader 白名单；完整 Matrix User ID
AGENTTEAMS_LEADER_IDS=@__SET_LEADER_MATRIX_USER_ID__
# [2] 自定义设置：Manager 白名单；完整 Matrix User ID
AGENTTEAMS_MANAGER_IDS=@__SET_MANAGER_MATRIX_USER_ID__

# ============================================================================
# §D 外部服务依赖
# ============================================================================

# ---- D1 PostgreSQL / Redis / Artifact MinIO ----

# [1] 手工按环境设置：agent-core PostgreSQL 连接串
DATABASE_URL=postgresql://chatflows_app_login:__SET_CHATFLOWS_APP_DB_PASSWORD__@内网地址:5432/chatflows
# [1] 手工按环境设置：agent-runtime JDBC URL
AGENT_RUNTIME_DATABASE_URL=jdbc:postgresql://内网地址:5432/chatflows
# [1] 手工按环境设置：agent-runtime PG 密码
DATABASE_PASSWORD=__SET_AGENT_RUNTIME_DB_PASSWORD__

# [1] 手工按环境设置：Redis 地址
REDIS_URL=redis://:__SET_REDIS_PASSWORD__@127.0.0.1:6379/0

# [1] 手工按环境设置：VibeSales Artifact MinIO 地址
MINIO_ENDPOINT=http://内网地址:19000
# [1] 手工按环境设置：Artifact MinIO Access Key
MINIO_ACCESS_KEY=__SET_ARTIFACT_MINIO_ACCESS_KEY__
# [1] 手工按环境设置：Artifact MinIO Secret Key
MINIO_SECRET_KEY=__SET_ARTIFACT_MINIO_SECRET_KEY__

# ---- D2 LLM 网关 ----

# [1] 手工按环境设置：Nest 侧 LLM Base URL
QWEN_BASE_URL=__SET_QWEN_BASE_URL__
# [1] 手工按环境设置：Nest 侧 LLM Token
QWEN_GATEWAY_TOKEN=__SET_QWEN_GATEWAY_TOKEN__
# [2] 自定义设置：Nest 默认模型
QWEN_MODEL=qwen3.7-plus
# [2] 自定义设置：Nest LLM 超时毫秒
QWEN_TIMEOUT_MS=60000

# [1] 手工按环境设置：Runtime 侧 LLM Base URL（sales-customer-agent 直接读取）
AGENT_MODEL_BASE_URL=http://内网地址:18080/v1
# [1] 手工按环境设置：Runtime 侧 LLM Token（三选一即可；另两个作备用兼容）
AGENT_MODEL_API_KEY=__SET_RUNTIME_LLM_TOKEN__
# [备用兼容] AppConfig 兜底回退键（优先读 AGENT_MODEL_API_KEY，空时才用）
DASHSCOPE_API_KEY=__SET_RUNTIME_LLM_TOKEN__

# [1] 手工按环境设置：Orchestrator 侧 LLM Base URL；ORCHESTRATOR_LLM=off 时可留占位
ORCHESTRATOR_LLM_BASE_URL=__SET_ORCHESTRATOR_LLM_BASE_URL__

# ---- D3 MCP 工具 ----

# [1] 手工按环境设置：Nest P3 业务 MCP 地址
P3C_BUSINESS_MCP_URL=__SET_P3C_BUSINESS_MCP_URL__
# [1] 手工按环境设置：Runtime MCP 地址
RUNTIME_MCP_URL=http://内网地址:18080/mcp-servers/chatflows-p3c
# [1] 手工按环境设置：Runtime MCP Token
RUNTIME_MCP_TOKEN=__SET_RUNTIME_MCP_TOKEN__

# ---- D4 AgentTeams 三平面 ----

# [1] 手工按环境设置：Controller REST 地址；宿主与容器共用
AGENTTEAMS_CONTROLLER_URL=http://内网地址:18090
# [3] 执行脚本后手工设置：从 controller cli-token 获取
AGENTTEAMS_AUTH_TOKEN=__SET_AGENTTEAMS_AUTH_TOKEN__

# [1] 手工按环境设置：Matrix CS API 地址；宿主与容器共用
AGENTTEAMS_MATRIX_URL=http://内网地址:18080
# [2] 自定义设置：VibeSales manager 使用的正式 Matrix 用户 ID
AGENTTEAMS_MATRIX_USER_ID=@__SET_MANAGER_MATRIX_USER_ID__
# [3] 执行脚本后手工设置：Human 创建后回填密码
AGENTTEAMS_MATRIX_PASSWORD=__SET_MANAGER_MATRIX_PASSWORD__
# [可选] 若改走 token 方式，可取消注释并填写；当前生产推荐使用 user+password
# AGENTTEAMS_MATRIX_ACCESS_TOKEN=__SET_MANAGER_MATRIX_ACCESS_TOKEN__

# [1] 手工按环境设置：Higress Console 管理用户
AGENTTEAMS_ADMIN_USER=__SET_HIGRESS_ADMIN_USER__
# [1] 手工按环境设置：Higress Console 管理密码
AGENTTEAMS_ADMIN_PASSWORD=__SET_HIGRESS_ADMIN_PASSWORD__

# [3] 执行脚本后手工设置：仅 configure-agentteams-worker-mcp.js 临时使用，不建议长期落盘
# AGENTTEAMS_WORKER_MATRIX_TOKEN=__SET_WORKER_MATRIX_TOKEN__

# [1] 手工按环境设置：Higress Console 地址；宿主与容器共用
AGENTTEAMS_HIGRESS_CONSOLE_URL=http://内网地址:18001
# [固定] Higress 上游直连宿主机 agent-core MCP 面
HIGRESS_CHATFLOWS_UPSTREAM=内网地址:3100
# [1] 手工按环境设置：对外 MCP 网关根地址；宿主与容器共用
CHATFLOWS_MCP_BASE_URL=http://内网地址:18080

# [1] 手工按环境设置：Task FS MinIO 地址；宿主与容器共用
CHATFLOWS_TASK_FS_ENDPOINT=http://内网地址:19000
# [固定] Task FS 受限账号名
CHATFLOWS_TASK_FS_ACCESS_KEY=chatflows-task-manager
# [4] 执行脚本自动写回 deploy/agentteams/integration.env
CHATFLOWS_TASK_FS_SECRET_KEY=__AUTO_SET_BY_CONFIGURE_CHATFLOWS_TASK_STORAGE__

# [1] 手工按环境设置：REST apply 存储地址
AGENTTEAMS_FS_ENDPOINT=http://内网地址:19000
# [1] 手工按环境设置：REST apply 存储 Access Key
AGENTTEAMS_FS_ACCESS_KEY=__SET_AGENTTEAMS_FS_ACCESS_KEY__
# [1] 手工按环境设置：REST apply 存储 Secret Key
AGENTTEAMS_FS_SECRET_KEY=__SET_AGENTTEAMS_FS_SECRET_KEY__
# [固定] REST apply 存储桶
AGENTTEAMS_FS_BUCKET=agentteams-storage

# [3] 执行脚本后手工设置：部署 Team/Human 后回填 teamRoomID
AGENTTEAMS_LEADER_ROOM_ID=__SET_TEAM_ROOM_ID__

# ---- D5 可选 YunFlow ----

# [1] 手工按环境设置：YunFlow 地址
YUNFLOW_BASE_URL=__SET_YUNFLOW_BASE_URL__
# [1] 手工按环境设置：YunFlow Token
YUNFLOW_TOKEN=__SET_YUNFLOW_TOKEN__
# [1] 手工按环境设置：YunFlow Space ID
YUNFLOW_SPACE_ID=__SET_YUNFLOW_SPACE_ID__

# ---- D6 可选可观测 ----

# [1] 手工按环境设置：OTLP traces endpoint
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=__SET_OTLP_TRACES_ENDPOINT__
# [1] 手工按环境设置：OTEL Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=__SET_OTEL_RESOURCE_ATTRIBUTES__
# [1] 手工按环境设置：ARMS License Key
ARMS_LICENSE_KEY=__SET_ARMS_LICENSE_KEY__
# [1] 手工按环境设置：OTLP Headers
OTEL_EXPORTER_OTLP_HEADERS=__SET_OTLP_HEADERS__

# [1] 手工按环境设置：旧版 AgentLoop 回退地址；不用可留空
AGENTLOOP_ENDPOINT=
# [1] 手工按环境设置：旧版 AgentLoop Access Key；不用可留空
AGENTLOOP_ACCESS_KEY=
# [1] 手工按环境设置：旧版 AgentLoop Secret；不用可留空
AGENTLOOP_ACCESS_SECRET=
