# ============================================================================
# agent-runtime.env.example
# 来源：根据 integration.env.example 按 split-integration-env.sh 的 RUNTIME_KEYS 拆分
#
# 配置方式标记：
#   [1] 手工按环境设置
#   [2] 自定义设置
# ============================================================================

# [固定]
RUNTIME_MODE=production
# [固定]
RUNTIME_HOST=127.0.0.1
# [1] 手工按环境设置
RUNTIME_PORT=8088
# [1] 手工按环境设置
AGENTSCOPE_WORKSPACE=/home/pad/chatflows/runtime-workspace
# [固定]
DATABASE_USER=agent_runtime_login
# [固定]
BLUEPRINT_ADMIN_URL=http://127.0.0.1:3100
# [2] 自定义设置：sales-customer-agent 模型名（仅模型名，不含 provider 前缀）
AGENT_MODEL_NAME=qwen-plus

# [2] 自定义设置；必须与 agent-core.env.example 中 BLUEPRINT_ADMIN_TOKEN 同值
BLUEPRINT_ADMIN_TOKEN=__CUSTOM_BLUEPRINT_ADMIN_TOKEN__
# [2] 自定义设置；必须与 agent-core.env.example 中 AGENT_RUNTIME_TOKEN 同值
RUNTIME_AUTH_TOKEN=__CUSTOM_RUNTIME_AUTH_TOKEN__
# [2] 自定义设置
RUNTIME_ADMIN_TOKEN=__CUSTOM_RUNTIME_ADMIN_TOKEN__

# [2] 自定义设置
AGENTLOOP_EXPORTER=off
# [2] 自定义设置
AGENTLOOP_SAMPLE_RATE=1.0
# [固定]
AGENTLOOP_PROTOCOL=otlp
# [固定]
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# [1] 手工按环境设置
AGENT_RUNTIME_DATABASE_URL=jdbc:postgresql://内网地址:5432/chatflows
# [1] 手工按环境设置
DATABASE_PASSWORD=__SET_AGENT_RUNTIME_DB_PASSWORD__
# [1] 手工按环境设置
REDIS_URL=redis://:__SET_REDIS_PASSWORD__@127.0.0.1:6379/0

# [1] 手工按环境设置：Runtime 侧 LLM Base URL（sales-customer-agent 直接读取）
AGENT_MODEL_BASE_URL=http://内网地址:18080/v1
# [1] 手工按环境设置：Runtime 侧 LLM Token（三选一即可；另两个作备用兼容）
AGENT_MODEL_API_KEY=__SET_RUNTIME_LLM_TOKEN__
# [备用兼容] AppConfig 兜底回退键（优先读 AGENT_MODEL_API_KEY，空时才用）
DASHSCOPE_API_KEY=__SET_RUNTIME_LLM_TOKEN__

# [1] 手工按环境设置
RUNTIME_MCP_URL=http://内网地址:18080/mcp-servers/chatflows-p3c
# [1] 手工按环境设置
RUNTIME_MCP_TOKEN=__SET_RUNTIME_MCP_TOKEN__

# [1] 手工按环境设置
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=__SET_OTLP_TRACES_ENDPOINT__
# [1] 手工按环境设置
OTEL_RESOURCE_ATTRIBUTES=__SET_OTEL_RESOURCE_ATTRIBUTES__
# [1] 手工按环境设置
ARMS_LICENSE_KEY=__SET_ARMS_LICENSE_KEY__
# [1] 手工按环境设置
OTEL_EXPORTER_OTLP_HEADERS=__SET_OTLP_HEADERS__

# [1] 手工按环境设置；不用可留空
AGENTLOOP_ENDPOINT=
# [1] 手工按环境设置；不用可留空
AGENTLOOP_ACCESS_KEY=
# [1] 手工按环境设置；不用可留空
AGENTLOOP_ACCESS_SECRET=
