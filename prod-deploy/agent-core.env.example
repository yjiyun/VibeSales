# ============================================================================
# agent-core.env.example
# 来源：根据 integration.env.example 按 split-integration-env.sh 的 CORE_KEYS 拆分
#
# 配置方式标记：
#   [1] 手工按环境设置
#   [2] 自定义设置
# ============================================================================

# [1] 手工按环境设置
WEB_HOST=0.0.0.0
# [1] 手工按环境设置
CHATFLOWS_ROOT=/home/pad/chatflows
# [固定]
ARTIFACT_STORE=postgres
# [2] 自定义设置
DATABASE_POOL_SIZE=10
# [1] 手工按环境设置
DATABASE_SSL=0
# [固定]
MINIO_BUCKET=chatflows-artifacts
# [固定]
FLOW_PLATFORM_MODE=production
# [固定]
ORCHESTRATION_MODE=platform
# [固定]
YUNFLOW_DRY_RUN_PATH=/api/workflow/{workflow_id}/run
# [固定]
AGENT_RUNTIME_URL=http://127.0.0.1:8088

# [2] 自定义设置；必须与 agent-manager.env.example 中 HIGRESS_CONSUMER_TOKEN 同值
MCP_SERVER_TOKEN=__CUSTOM_MCP_SERVER_TOKEN__
# [2] 自定义设置；必须与 agent-manager.env.example 中 PIPELINE_CONTROL_TOKEN 同值
PIPELINE_CONTROL_TOKEN=__CUSTOM_PIPELINE_CONTROL_TOKEN__
# [2] 自定义设置；必须与 agent-runtime.env.example 中 BLUEPRINT_ADMIN_TOKEN 同值
BLUEPRINT_ADMIN_TOKEN=__CUSTOM_BLUEPRINT_ADMIN_TOKEN__
# [2] 自定义设置；必须与 agent-runtime.env.example 中 RUNTIME_AUTH_TOKEN 同值
RUNTIME_AUTH_TOKEN=__CUSTOM_RUNTIME_AUTH_TOKEN__
# [2] 自定义设置；必须与 agent-runtime.env.example 中 RUNTIME_AUTH_TOKEN 同值
AGENT_RUNTIME_TOKEN=__CUSTOM_RUNTIME_AUTH_TOKEN__
# [2] 自定义设置；必须与 agent-manager.env.example 中 CHATFLOWS_APPROVAL_SIGNING_SECRET 同值
PIPELINE_APPROVAL_SIGNING_SECRET=__CUSTOM_APPROVAL_SIGNING_SECRET__

# [1] 手工按环境设置；当前生产默认不启用，可按需取消注释
# WEB_AUTH_TOKEN=__CUSTOM_WEB_AUTH_TOKEN__
# [1] 手工按环境设置；当前生产默认不启用，可按需取消注释
# WEB_AUTH_CLIENT_CODE=__SET_WEB_AUTH_CLIENT_CODE__

# [2] 自定义设置
AGENTLOOP_EXPORTER=off
# [2] 自定义设置
AGENTLOOP_SAMPLE_RATE=1.0
# [固定]
AGENTLOOP_PROTOCOL=otlp
# [固定]
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# [1] 手工按环境设置
QWEN_BASE_URL=__SET_QWEN_BASE_URL__
# [1] 手工按环境设置
QWEN_GATEWAY_TOKEN=__SET_QWEN_GATEWAY_TOKEN__
# [2] 自定义设置
QWEN_MODEL=qwen3.7-plus
# [2] 自定义设置
QWEN_TIMEOUT_MS=60000

# [1] 手工按环境设置
DATABASE_URL=postgresql://chatflows_app_login:__SET_CHATFLOWS_APP_DB_PASSWORD__@内网地址:5432/chatflows

# [1] 手工按环境设置
P3C_BUSINESS_MCP_URL=__SET_P3C_BUSINESS_MCP_URL__

# [1] 手工按环境设置
MINIO_ENDPOINT=http://内网地址:19000
# [1] 手工按环境设置
MINIO_ACCESS_KEY=__SET_ARTIFACT_MINIO_ACCESS_KEY__
# [1] 手工按环境设置
MINIO_SECRET_KEY=__SET_ARTIFACT_MINIO_SECRET_KEY__

# [1] 手工按环境设置
YUNFLOW_BASE_URL=__SET_YUNFLOW_BASE_URL__
# [1] 手工按环境设置
YUNFLOW_TOKEN=__SET_YUNFLOW_TOKEN__
# [1] 手工按环境设置
YUNFLOW_SPACE_ID=__SET_YUNFLOW_SPACE_ID__

# [1] 手工按环境设置
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=__SET_OTLP_TRACES_ENDPOINT__
# [1] 手工按环境设置
OTEL_RESOURCE_ATTRIBUTES=__SET_OTEL_RESOURCE_ATTRIBUTES__
# [1] 手工按环境设置
ARMS_LICENSE_KEY=__SET_ARMS_LICENSE_KEY__
# [1] 手工按环境设置
OTEL_EXPORTER_OTLP_HEADERS=__SET_OTLP_HEADERS__

# [1] 手工按环境设置；不用可留空
AGENTLOOP_ENDPOINT=
# [1] 手工按环境设置；不用可留空
AGENTLOOP_ACCESS_KEY=
# [1] 手工按环境设置；不用可留空
AGENTLOOP_ACCESS_SECRET=
