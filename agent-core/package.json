{
  "name": "agent-core",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AgentTeams Chatflows: P1-P4 pipeline and MCP business tools",
  "scripts": {
    "cli": "ts-node -r dotenv/config src/main.ts",
    "p1": "ts-node -r dotenv/config src/main.ts p1",
    "wizard": "ts-node -r dotenv/config src/main.ts p1-wizard",
    "test:p1": "node scripts/test-p1.js",
    "test:p3c-signals": "ts-node -r dotenv/config scripts/test-p3c-signals.ts",
    "test:p3c-rules": "ts-node -r dotenv/config scripts/test-p3c-rules.ts",
    "test:agentteams": "ts-node -r dotenv/config scripts/test-agentteams-e2e.ts",
    "test:p3c-industries": "ts-node -r dotenv/config scripts/export-p3c-industry-smokes.ts",
    "test:mcp": "ts-node -r dotenv/config scripts/test-mcp-contract.ts",
    "test:mcp-startup": "ts-node -r dotenv/config scripts/test-mcp-plane-startup.ts",
    "test:mcp-production": "ts-node -r dotenv/config scripts/test-mcp-production-module.ts",
    "test:control": "ts-node -r dotenv/config scripts/test-control-contract.ts",
    "test:web-auth": "ts-node scripts/test-web-auth-contract.ts",
    "test:qwen-gateway": "ts-node scripts/test-qwen-gateway-contract.ts",
    "test:agentloop-aggregation": "ts-node scripts/test-agentloop-aggregation.ts",
    "test:agentloop-messages": "ts-node scripts/test-agentloop-messages.ts",
    "test:span-aliases": "ts-node scripts/test-span-aliases.ts",
    "test:otlp-sink": "ts-node scripts/test-otlp-sink.ts",
    "test:worker-mcp": "ts-node -r dotenv/config scripts/test-worker-mcp-e2e.ts",
    "test:approval-proof": "ts-node -r dotenv/config scripts/test-approval-proof.ts",
    "db:init": "ts-node -r dotenv/config scripts/init-agentteams-db.ts",
    "test:postgres-contract": "ts-node -r dotenv/config scripts/test-postgres-contract.ts",
    "token:total": "ts-node -r dotenv/config scripts/token-total.ts",
    "web": "ts-node -r dotenv/config src/main-web.ts",
    "build": "tsc -p tsconfig.json",
    "mcp": "ts-node -r dotenv/config src/main-mcp.ts",
    "start:prod": "node dist/main-mcp.js",
    "start:web": "node dist/main-web.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "dotenv": "^16.4.7",
    "fflate": "0.8.3",
    "log4js": "^6.9.1",
    "minio": "8.0.6",
    "nest-commander": "^3.15.0",
    "openai": "^4.77.0",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "8.15.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
