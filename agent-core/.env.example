# 千问 / DashScope OpenAI 兼容 API（DEMO）
# 复制为 .env 后填入真实值：cp .env.example .env
# 勿将含密钥的 .env 提交到 Git

# 【必填·联调意图/千问裁决时】DashScope API Key
DASHSCOPE_API_KEY=
# 生产只用以下 Higress 消费者凭证；生产进程不得注入上面的真实 DashScope Key。
QWEN_GATEWAY_TOKEN=

# 【可选】OpenAI 兼容 Base URL（一般不用改）
# 默认值是 DashScope 公开端点，可替换为任意 OpenAI 兼容服务（自建网关 / vLLM / OpenAI 等）。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 【可选】模型名：质量速度均衡可用 qwen3.7-plus；更省可用 qwen3.6-flash
QWEN_MODEL=qwen3.7-plus

# 【可选】请求超时（毫秒）
QWEN_TIMEOUT_MS=60000

# 【可选】仓库根（扫 flows/Chatflow-* / catalogs / prompts）；留空则默认 agent-core 的上一级
# CHATFLOWS_ROOT=

# 【可选】附加模板根（逗号分隔，默认空）：在 flows/ 之外再扫几个目录的 Chatflow-*。
# 真实资产下同一 scene 只有一个包，Decide 的「2+ 候选」分支（via=qwen / diffs /
# 卡片落选区 alternatives）走不到；指向 fixtures/templates 可把候选顶到 2 来验这条路。
# 相对路径按 agent-core 项目根解析；目录不存在会直接报错（配了没生效更危险）。
# TEMPLATE_EXTRA_ROOTS=fixtures/templates

# ---------- Web 层（npm run web；CLI 不受影响）----------
# 只有 main-web.ts 会 app.listen()，CLI 入口仍是 ApplicationContext。

# 【可选】监听端口（默认 3100）
WEB_PORT=3100

# 【可选】监听地址（默认 127.0.0.1）
# npm run web 是无鉴权 DEMO；生产 npm run start:prod 只加载 MCP/审批/Blueprint 管理面且各自鉴权。
WEB_HOST=127.0.0.1

# 【可选】CORS（默认 on）：允许前端 Vite dev server（5173）跨端口联调
# 前端已 npm run web:build、由后端同源托管时可设为 off
WEB_CORS=on

# ---------- AgentTeams P3/P4 生产边界 ----------
# file 仅供离线演示；生产必须 postgres，缺依赖时启动即失败，不降级。
ARTIFACT_STORE=postgres
DATABASE_URL=postgresql://chatflows_app:replace-me@postgres:5432/chatflows
DATABASE_POOL_SIZE=10
DATABASE_SSL=0

# 大产物正文写 MinIO，artifact.payload 只保存带 sha256 的对象引用。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatflows-artifacts

# P3/P3B 导入 YunFlow。production 使用冻结的 multipart /api/workflow/import_zip。
FLOW_PLATFORM_MODE=production
YUNFLOW_BASE_URL=http://yunflow:8080
YUNFLOW_TOKEN=
YUNFLOW_SPACE_ID=
# 部署方必须填写已冻结的执行接口模板；{workflow_id} 为必需占位符。
YUNFLOW_DRY_RUN_PATH=/api/workflow/{workflow_id}/run

# P3C P4 冒烟与管理员发布控制面。
AGENT_RUNTIME_URL=http://agent-runtime:8088
AGENT_RUNTIME_TOKEN=
BLUEPRINT_ADMIN_TOKEN=
PIPELINE_CONTROL_TOKEN=
ORCHESTRATION_MODE=local
# Human 审批短时凭据 HMAC（至少 32 字符，与普通控制 Bearer 分离）。
PIPELINE_APPROVAL_SIGNING_SECRET=
# Higress → Nest MCP 上游注入凭证（不是 Worker 的业务 Key）；后端默认关闭，禁止绕过网关直连。
MCP_SERVER_TOKEN=
# P3C 写入 Blueprint 的业务工具网关地址，必须是 Higress 的 HTTPS MCP 路径。
P3C_BUSINESS_MCP_URL=http://<GATEWAY_HOST>:18080/mcp-servers/business-tools/mcp

# ---- AgentLoop 唯一观测出口（A22/A12；off 时只保留本地 trace）----
# 业务开关：off 不导出；stderr 只打信封（本地/verify 默认）；on 才真上报公网。
AGENTLOOP_EXPORTER=off
AGENTLOOP_SAMPLE_RATE=1.0
# 协议：otlp（默认，标准 OTLP/HTTP 直发，AI Agent 面板识别）| roa（回滚：自建 OpenAPI + ROA 签名）。
AGENTLOOP_PROTOCOL=otlp
# OTLP 接入参数（AGENTLOOP_PROTOCOL=otlp 时用）。service.name 缺省时代码内置 vibe-sales-nest。
OTEL_SERVICE_NAME=vibe-sales-nest
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou.cn-guangzhou.log.aliyuncs.com/apm/trace/opentelemetry/v1/traces
OTEL_RESOURCE_ATTRIBUTES=service.version=v0.1.0,deployment.environment=production,acs.cms.workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5,acs.arms.service.feature=genai_app,gen_ai.instrumentation.sdk.name=loongsuite-genai-utils
# LicenseKey 从密钥服务注入，切勿写进提交版 .env；轮换后只改这一处。
ARMS_LICENSE_KEY=
OTEL_EXPORTER_OTLP_HEADERS=x-arms-license-key=${ARMS_LICENSE_KEY},x-arms-project=proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou,x-cms-workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5
# ROA（AGENTLOOP_PROTOCOL=roa 时用；OTLP 迁移完成后可移除）。
AGENTLOOP_ENDPOINT=
AGENTLOOP_ACCESS_KEY=
AGENTLOOP_ACCESS_SECRET=

# ---------- 可观测：一次打点，三个去处 ----------
# 业务代码只调 trace.step(scope, event, data)，输出到哪、落多详细由下面两个档位决定：
#   LOG_STDERR  刷屏（不污染 stdout 结果 JSON，仍可 | jq）
#   LOG_FILE    写文件（logs/app.log、logs/token.log）
#   第三个去处只在 Web 请求内生效：事件随 HTTP 回包给界面运行面板，无档位、不可配
# 两者**互不影响**：向导默认静默 stderr，文件照写，因此排障不依赖当时开没开 trace。
# 档位取值：off=不输出；on=常规打点（提示词正文只留长度）；verbose=含提示词与模型原文全文

# 【可选】stderr 档位（默认 on）
# CLI 也可：--quiet（=off）/ --verbose（=verbose）；旧名 --trace-off / --trace-full 仍生效
LOG_STDERR=on
WEB_AUTH_TOKEN=replace-with-at-least-16-characters
WEB_AUTH_CLIENT_CODE=acme_beauty
# 多租户生产配置优先使用 WEB_AUTH_CREDENTIALS JSON 数组，token 在服务端绑定 client_code/actor/roles。

# 【可选】旧名，仍兼容（LOG_STDERR 未设时读它）：1=on，0=off，full=verbose
# DEMO_TRACE=1

# ---------- 文本日志（log4js，写文件）----------

# 【可选】文件档位（默认 on）；旧名 LOG_ENABLED=0 仍兼容为 off
LOG_FILE=on

# 【可选】严重度门槛：info（默认）/ warn / error，只过滤严重度，不管详略
# 旧写法 LOG_LEVEL=debug 会被映射为 LOG_FILE=verbose
LOG_LEVEL=info

# 【可选】日志目录（相对 agent-core/ 运行目录）
# app.log   全链路流水（模块 | 流程 | 位置 | 耗时）
# token.log 大模型 token 用量专用（JSON Lines，可直接 jq 统计）
LOG_DIR=logs

# 【可选】单文件上限（字节，默认 5MB）与滚动保留份数（默认 5）
# 注意 token-total.json 不受此约束：它不滚动，见下
LOG_MAX_SIZE=5242880
LOG_BACKUPS=5

# ---------- 工程累计 token 台账（logs/token-total.json）----------
# token.log 会按大小滚动、滚掉即永久丢；台账不滚动，所以「工程一共烧了多少」始终成立。
# 每次流程结束读-改-写一次（tmp + rename 原子替换），记 all_time / by_day / by_month /
# by_node / by_model。校对与重建：npm run token:total [-- --rebuild]

# 【可选】开关（默认跟随 LOG_FILE）：off / 0 / false 关闭
# TOKEN_LEDGER=on

# 【可选】by_day 保留多少天的日明细（默认 90，0 = 全留）
# 过期的只丢日粒度：by_month 与 all_time 是独立累加的，总账不受影响
# TOKEN_LEDGER_DAYS=90
