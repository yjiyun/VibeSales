AGENTTEAMS_CONTROLLER_URL=http://agentteams-controller:8090
AGENTTEAMS_AUTH_TOKEN=
AGENTTEAMS_MATRIX_URL=http://agentteams-matrix:6167
AGENTTEAMS_MATRIX_ACCESS_TOKEN=
AGENTTEAMS_MATRIX_USER_ID=@agent-manager:localhost
AGENTTEAMS_MATRIX_PASSWORD=
# ManagerConfig 读这五项：prefix 受限的任务目录专用身份，由
# scripts/configure-chatflows-task-storage.js 创建。不要填平台 MinIO admin 身份
# （AGENTTEAMS_FS_*，那套只给 REST apply 投影 Skill 用）。
CHATFLOWS_TASK_FS_ENDPOINT=http://agentteams-minio:9000
CHATFLOWS_TASK_FS_ACCESS_KEY=chatflows-task-manager
CHATFLOWS_TASK_FS_SECRET_KEY=
CHATFLOWS_TASK_FS_BUCKET=agentteams-storage
CHATFLOWS_TASK_FS_PREFIX=teams/chatflows-build-team/shared/tasks
CHATFLOWS_APPROVAL_SIGNING_SECRET=
# Human/Manager 是信任边界，必须显式配置且三类身份互不重叠；
# Leader/Room 可留空，由 Controller 在资源 apply ready 后自动发现。
AGENTTEAMS_HUMAN_IDS=@admin:localhost
AGENTTEAMS_LEADER_IDS=
AGENTTEAMS_MANAGER_IDS=@agent-manager:localhost
AGENTTEAMS_LEADER_ROOM_ID=
AGENTTEAMS_RUN_TIMEOUT_SECONDS=3600
AGENTTEAMS_TEAM_NAME=chatflows-build-team
AGENTTEAMS_LEADER_NAME=chatflows-leader
AGENTTEAMS_TEAM_FILE=/resources/team.yaml
CHATFLOWS_NEST_URL=http://agent-core:3100
PIPELINE_CONTROL_TOKEN=
# A23：两者都 >=16 字符且不相等，否则 AuthService 构造器在 serve 时抛错。
MANAGER_AUTH_TOKEN=
MANAGER_ADMIN_TOKEN=
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8090
# verify-all/local 默认 off；生产启用时必须经 Higress（HTTPS，容器私网允许 HTTP）。
ORCHESTRATOR_LLM=off
ORCHESTRATOR_MODEL=dashscope:qwen-plus
ORCHESTRATOR_LLM_BASE_URL=https://model.higress.example/v1
HIGRESS_CONSUMER_TOKEN=
ORCHESTRATOR_STATE_HOME=/data/orchestrator-state
# ---- AgentLoop 可观测（OTLP 直发，A22/A12）----
# 业务开关：off 不导出；stderr 只打本地；on 才真上报公网。
AGENTLOOP_EXPORTER=off
AGENTLOOP_SAMPLE_RATE=1.0
# 上报协议：otlp（默认，标准 OTLP 直发，AI Agent 面板可解析）| roa（旧 OpenAPI 镜像）
AGENTLOOP_PROTOCOL=otlp
# OTLP 接入参数（标准 OTel，SDK autoconfigure 直读）。
OTEL_SERVICE_NAME=vibe-sales-manager
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou.cn-guangzhou.log.aliyuncs.com/apm/trace/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.version=v0.1.0,deployment.environment=production,acs.cms.workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5,acs.arms.service.feature=genai_app,gen_ai.instrumentation.sdk.name=loongsuite-genai-utils
# LicenseKey 从密钥服务注入，切勿写进提交版 .env；轮换后只改这一处。
ARMS_LICENSE_KEY=
OTEL_EXPORTER_OTLP_HEADERS=x-arms-license-key=${ARMS_LICENSE_KEY},x-arms-project=proj-xtrace-3922099f398c18d91efc45571ab29-cn-guangzhou,x-cms-workspace=agentloop-7f371f9a844483cf38ba3e84bc46add5
# ROA（旧 OpenAPI 通路），OTLP 迁移完成后移除。
AGENTLOOP_ENDPOINT=
AGENTLOOP_ACCESS_KEY=
AGENTLOOP_ACCESS_SECRET=
